{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run whoami *)",
      "Bash(npm run guard *)",
      "Bash(npm run task *)",
      "Bash(npm run task:start *)",
      "Bash(npm run board *)",
      "Bash(npm run handoff *)",
      "Bash(npm run sync *)",
      "Bash(npm run verify *)",
      "Bash(npm run check *)",
      "Bash(npm run format *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run smoke *)",
      "Bash(npm run db:reset *)",
      "Bash(npm run doctor *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit -m *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--delete*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git update-ref *)",
      "Bash(git filter-branch *)",
      "Bash(git -c *)",
      "Bash(git config *hooksPath*)",
      "Bash(git config *hackathon.role*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/guard.mjs\" banner",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/guard.mjs\" claude-hook",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
