# API settings. `node scripts/setup-dev.mjs` copies this to apps/api/.env — never commit .env.
# Add every new variable here (with a comment) AND in src/env.ts.

PORT=8787
DB_FILE=./data/app.db

# off | fixtures — "fixtures" makes external/LLM calls return recorded responses (demo safety net).
DEMO_MODE=off

# Gemini (extracts the farm profile and phrases the summary). Server-side only; get a key at aistudio.google.com.
# Leave it empty and set DEMO_MODE=fixtures to run offline on the recorded examples.
# GEMINI_API_KEY=
# Model name (check it is still available if calls start failing) and how long to wait before giving up.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# Secrets are server-side only. Share real values in person, never in the repo or chat logs.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
