# API settings. `node scripts/setup-dev.mjs` copies this to apps/api/.env — never commit .env.
# Add every new variable here (with a comment) AND in src/env.ts.

PORT=8787
DB_FILE=./data/app.db

# off | fixtures — "fixtures" makes external/LLM calls return recorded responses (demo safety net).
DEMO_MODE=off

# OpenAI (extracts the farm profile and phrases the summary). Server-side only; we switched from Gemini (replaces decision D-012).
# Leave the key empty and set DEMO_MODE=fixtures to run offline on the recorded examples.
# OPENAI_API_KEY=
# Model name (check it is still available if calls start failing) and how long to wait before giving up.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000

# Secrets are server-side only. Share real values in person, never in the repo or chat logs.
# ANTHROPIC_API_KEY=

# Inbound phone line (Twilio). The auth token checks X-Twilio-Signature on /api/voice/*.
# Buy a voice number in the Twilio console and set its webhook to https://<tunnel>/api/voice/incoming (HTTP POST).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Public origin only, no path and no trailing slash. Required when a tunnel sits in front of localhost.
# This ngrok tunnel does not forward X-Twilio-Signature. A missing signature is accepted
# only when x-forwarded-host matches this origin. A wrong signature is still rejected.
# TWILIO_PUBLIC_BASE=https://example.trycloudflare.com
# The Twilio voice number Ring calls from, with the country code and no spaces.
# TWILIO_FROM_NUMBER=+353800000000
# The only mobiles Ring may dial, comma-separated. A trial account must verify each one first.
# TWILIO_RING_TO=+353800000000
