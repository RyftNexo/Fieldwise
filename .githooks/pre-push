#!/bin/sh
# Team guard (docs/OWNERSHIP.md): no pushes to main, only your own branches, ownership of the whole branch.
# Agents must never bypass this hook (no --no-verify). Owner: dev3.
command -v node >/dev/null 2>&1 || {
  echo "pre-push: 'node' is not on PATH, so the team guard can't run. See README > Troubleshooting." >&2
  exit 1
}
exec node "$(git rev-parse --show-toplevel)/scripts/guard.mjs" pre-push "$@"
