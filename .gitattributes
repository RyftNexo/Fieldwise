# Normalise line endings so Windows/macOS/Linux machines never produce whole-file diffs.
* text=auto eol=lf

# Hooks must stay LF to run under sh on every OS.
.githooks/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.db binary

# Generated: never hand-merge — regenerate with `npm install` (see docs/TEAM_POLICY.md § Conflicts).
package-lock.json -diff linguist-generated=true
